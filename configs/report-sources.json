{
  "alibaba_qwen": {
    "org": "Alibaba",
    "hub": "Qwen",
    "official": [
      "https://qwenlm.github.io/blog/",
      "https://www.alibabacloud.com/help/en/model-studio/model-release-notes"
    ],
    "model_pattern": "Qwen[ -]?\\d+(?:\\.\\d+|[-]\\d+(?![\\dA-Za-z]))?(?:[- ](?:Max|Plus|Flash|Turbo|Next|Preview|Thinking|Instruct|Coder|Omni|VL|Audio|Base|Embedding|Reranker|Math|Image|Stage\\d+|A?\\d+(?:\\.\\d+)?[BMT]|\\d{4})){0,8}(?![\\w-]|\\.\\w)",
    "hosts": [
      "github.com",
      "qianwen-res.oss-cn-beijing.aliyuncs.com",
      "qwen.ai",
      "qwenlm.github.io",
      "raw.githubusercontent.com",
      "www.alibabacloud.com"
    ],
    "group_sizes": true,
    "exclude_models": [
      "^Qwen[- ]Drive\\b",
      "^Qwen[- ]Image.*[- ]PE[- ](?:T2I|I2I)\\b"
    ]
  },
  "allenai": {
    "org": "Allen AI",
